#!/bin/sh
# Echo harness-relevant argv facts through the reply so the E2E can assert the spawned process
# actually RECEIVED them (mirrors test/fixtures/codex): a resume turn must carry -r, and MCP
# injection must ride --mcp-config. Unit tests on buildClaudeArgs can't prove the spawn.
resume=no; mcp=no; cancel=no; fail=no; auth_fail=no; limit_fail=no; limit_answer=no; memory_save=no; answerless=no; mcp_path=""; prev=""
# Whether the gateway handed this process a relayed login (CLAUDE_CODE_OAUTH_TOKEN). The value
# itself is never echoed — only that it was there — so the E2E can prove the spawn was
# authenticated the way a real turn would be.
oauth=no; [ -n "$CLAUDE_CODE_OAUTH_TOKEN" ] && oauth=yes
transient_times=0; transient_after_text=no; session_id=""; model=""; reject_model=no; reject_all_models=no; stream_text=no
for arg in "$@"; do
  case "$arg" in
    -r) resume=yes ;;
    --mcp-config) mcp=yes ;;
    *CLAUDE_STUB_WAIT_FOR_CANCEL*) cancel=yes ;;
    *CLAUDE_STUB_FAIL_GENERIC*) fail=yes ;;
    *CLAUDE_STUB_TRANSIENT_TWICE*) transient_times=2 ;;
    *CLAUDE_STUB_TRANSIENT_ALWAYS*) transient_times=999 ;;
    *CLAUDE_STUB_TRANSIENT_AFTER_TEXT*) transient_after_text=yes ;;
    *CLAUDE_STUB_REJECT_MODEL*) reject_model=yes ;;
    *CLAUDE_STUB_REJECT_ALL_MODELS*) reject_all_models=yes ;;
    *CLAUDE_STUB_AUTH_FAIL_SAFE*) auth_fail=yes ;;
    *CLAUDE_STUB_LIMIT_FAIL_SAFE*) limit_fail=yes ;;
    *CLAUDE_STUB_LIMIT_ANSWER*) limit_answer=yes ;;
    *CLAUDE_STUB_MEMORY_SAVE*) memory_save=yes ;;
    *CLAUDE_STUB_ANSWERLESS*) answerless=yes ;;
  esac
  if [ "$prev" = "--mcp-config" ]; then mcp_path="$arg"; fi
  if [ "$prev" = "--session-id" ]; then session_id="$arg"; fi
  if [ "$prev" = "--model" ]; then model="$arg"; fi
  prev="$arg"
done
# Checked outside the loop's case: a `case` runs only its FIRST matching branch per argument, so a
# prompt that carries this sentinel ALONGSIDE another one (a rejection to stream the retry of)
# would otherwise silence the other.
case "$*" in *CLAUDE_STUB_STREAM_TEXT*) stream_text=yes ;; esac
if [ "$cancel" = "yes" ]; then
  exec sleep 30
fi
# Keep a copy of the per-run MCP config: it carries the signed gateway capability, which is the
# only way an E2E can observe WHEN that capability was minted (the real file is deleted as soon as
# the run settles). Named after the run's own folder so test files running in parallel can never
# overwrite each other's copy.
if [ -n "$mcp_path" ] && [ -f "$mcp_path" ]; then
  cp "$mcp_path" "${TMPDIR:-/tmp}/cg-stub-mcp-$(basename "$PWD").json" 2>/dev/null || true
fi
# A provider that is briefly unavailable ("API Error: 529 Overloaded") for the first N invocations
# of this folder, then answers — the gateway must retry in place and still post the reply.
# The real CLI refuses to CREATE a session id twice ("Session ID … is already in use" — the failed
# attempt already wrote that id's transcript), so in this mode a repeated --session-id is refused
# the same way: a retried fresh turn has to arrive under a new id. Counter and ledger live in the
# run cwd; a garbage counter reads as 0 (the stub fails again — loud, never a silent pass).
refuse_reused_session_id() {
  [ -n "$session_id" ] || return 0
  if [ -f .cg-stub-sessions ] && grep -qxF "$session_id" .cg-stub-sessions; then
    printf 'Error: Session ID %s is already in use.\n' "$session_id" >&2
    exit 1
  fi
  echo "$session_id" >> .cg-stub-sessions
}
if [ "$transient_times" -gt 0 ]; then
  refuse_reused_session_id
  count=$(tr -dc 0-9 < .cg-stub-transient 2>/dev/null); count=${count:-0}
  if [ "$count" -lt "$transient_times" ]; then
    echo $((count + 1)) > .cg-stub-transient
    printf '%s\n' '{"type":"assistant","error":"server_error","message":{"role":"assistant","content":[{"type":"text","text":"API Error: 529 Overloaded"}]}}'
    exit 1
  fi
fi
# The same failure AFTER part of the answer already streamed: the thread has seen text, so the turn
# must NOT be replayed (a replay would append a second answer under the first half).
if [ "$transient_after_text" = "yes" ]; then
  printf '%s\n' '{"type":"stream_event","event":{"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"Half an answer, then the stream dropped"}}}'
  printf '%s\n' '{"type":"assistant","error":"server_error","message":{"role":"assistant","content":[{"type":"text","text":"API Error: Connection dropped (ECONNRESET)"}]}}'
  exit 1
fi
# A model the provider does not serve, as the CLI reports it (label model_not_found): the turn did
# nothing, so the gateway replays it with the gateway default model — under a NEW session id, which
# the ledger enforces the same way as the transient retry above.
if [ "$reject_all_models" = "yes" ] || { [ "$reject_model" = "yes" ] && [ "$model" = "opus" ]; }; then
  refuse_reused_session_id
  printf '{"type":"assistant","error":"model_not_found","message":{"role":"assistant","content":[{"type":"text","text":"There'"'"'s an issue with the selected model (%s). It may not exist or you may not have access to it."}]}}\n' "$model"
  exit 1
fi
if [ "$auth_fail" = "yes" ]; then
  printf '%s\n' '{"type":"assistant","error":"authentication_failed","message":{"role":"assistant","content":[{"type":"text","text":"OAuth session expired and could not be refreshed"}]}}'
  exit 1
fi
if [ "$limit_fail" = "yes" ]; then
  printf '%s\n' '{"type":"assistant","error":"rate_limit","message":{"role":"assistant","content":[{"type":"text","text":"Session limit reached; resets at 6am"}]}}'
  exit 1
fi
# A limit that arrives as the ANSWER: the CLI exits 0 and its "reply" is the notice, with no
# tokens spent. The orchestrator detects that shape separately from a thrown provider failure.
if [ "$limit_answer" = "yes" ]; then
  printf '%s\n' "{\"type\":\"result\",\"subtype\":\"success\",\"result\":\"You have hit your usage limit. Try again at 6am.\",\"session_id\":\"stub-session\",\"usage\":{\"input_tokens\":0,\"output_tokens\":0}}"
  exit 0
fi
# A memory reviewer that SAVES: one streamed tool_use for the gateway save tool (the shape the
# stream consumer turns into a tool_use event), then a one-line "Saved: …" reply. Lets the
# memory-review E2E observe "saved something" → notice posted, without a real MCP round-trip.
if [ "$memory_save" = "yes" ]; then
  printf '%s\n' '{"type":"stream_event","event":{"type":"content_block_start","index":0,"content_block":{"type":"tool_use","id":"toolu_mem","name":"mcp__gateway__update_channel_memory","input":{}}}}'
  printf '%s\n' '{"type":"stream_event","event":{"type":"content_block_stop","index":0}}'
  printf '%s\n' '{"type":"result","subtype":"success","result":"Saved: Alex prefers short replies.","session_id":"stub-session","usage":{"input_tokens":30,"output_tokens":8},"total_cost_usd":0.0004}'
  exit 0
fi
# A turn that DID work and then ended with no answer: a tool call ran, tokens were spent, and the
# CLI's terminal line is an error subtype carrying no `result` text — the real shape behind the
# "(empty response)" incidents. Exit 0, exactly like the CLI does.
if [ "$answerless" = "yes" ]; then
  printf '%s\n' '{"type":"stream_event","event":{"type":"content_block_start","index":0,"content_block":{"type":"tool_use","id":"toolu_ans","name":"Bash","input":{}}}}'
  printf '%s\n' '{"type":"stream_event","event":{"type":"content_block_stop","index":0}}'
  printf '%s\n' '{"type":"result","subtype":"error_during_execution","is_error":true,"session_id":"stub-session","usage":{"input_tokens":900,"output_tokens":120},"total_cost_usd":0.02}'
  exit 0
fi
if [ "$fail" = "yes" ]; then
  printf '%s\n' 'stub failure detail' >&2
  exit 1
fi
# A turn whose answer arrives as TEXT DELTAS, the way a real Claude turn does — the reply the
# gateway returns is then the concatenation of what already streamed into the Slack message, which
# is what makes "the delivered answer" and "result.content" two different things.
if [ "$stream_text" = "yes" ]; then
  printf '%s\n' "{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"text_delta\",\"text\":\"Stub engine reply (resume=$resume; mcp=$mcp; oauth=$oauth; model=$model)\"}}}"
fi
printf '%s\n' "{\"type\":\"result\",\"subtype\":\"success\",\"result\":\"Stub engine reply (resume=$resume; mcp=$mcp; oauth=$oauth; model=$model)\",\"session_id\":\"stub-session\",\"usage\":{\"input_tokens\":12,\"output_tokens\":4},\"total_cost_usd\":0.001}"
