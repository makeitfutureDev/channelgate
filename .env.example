# ── Slack (Socket Mode) ───────────────────────────────────────────────────────
# Bot User OAuth Token (xoxb-…) — Slack app → OAuth & Permissions
SLACK_BOT_TOKEN=
# App-Level Token (xapp-…) with connections:write — Slack app → Basic Information → App-Level Tokens
SLACK_APP_TOKEN=
# Signing secret — Slack app → Basic Information (Bolt requires it even in Socket Mode)
SLACK_SIGNING_SECRET=

# ── Daemon ────────────────────────────────────────────────────────────────────
# HTTP port for the admin UI + health endpoint.
PORT=4747
# Bootstrap admin password. A new install generates a first-boot password when this is unset.
# The UI requires authentication; see INSTALL.md for first-boot password retrieval.
ADMIN_PASSWORD=
# Override the gateway runtime root (default: ~/.channelgate). The pre-rename name
# CLAUDE_GATEWAY_DIR is still honoured for one major, with a deprecation warning at boot.
# CHANNELGATE_DIR=/home/operator/.channelgate
# Override the SQLite database file (default: <runtime root>/gateway.db). Pre-rename name:
# CLAUDE_GATEWAY_DB.
# CHANNELGATE_DB=/home/operator/.channelgate/gateway.db
# Override the VISIBLE workspace root that holds each channel's working folder
# (default: ~/ChannelGate; folders are ~/ChannelGate/<platform>/<slug>, platform being
# slack / teams / google-chat).
# CG_WORKSPACE_DIR=/home/operator/ChannelGate
# Extra hostnames allowed to reach /api (comma-separated). Loopback and the host of a configured
# publicUrl are always allowed; anything else is refused so a rebound DNS name can't drive the
# admin API from a victim's browser. Set this only if you front the gateway with another hostname.
# CG_ALLOWED_HOSTS=gateway.example.com
# Honour X-Forwarded-For from a NON-loopback socket. The per-address backoffs (admin login, approval
# links) already read the forwarded client when the request comes from a proxy on this host, where
# the header cannot be forged. Set this only if your reverse proxy runs on another machine AND
# rewrites X-Forwarded-For — otherwise clients pick their own rate-limit bucket.
# CG_TRUST_PROXY=1
# How often a QUIET turn reports itself (e.g. 10m, 600s). Default 10m. This is an inactivity
# window, not a runtime cap: any output re-arms it, so a busy turn runs as long as it needs.
# Reaching it no longer kills the turn — the gateway checks the engine process is still alive and,
# if it is, tells the user "no output for Nm — still connected" and keeps waiting. Lower it to see
# those reports sooner. Applies to the warm and cold Claude paths and to Codex.
COMMAND_TIMEOUT=10m
# When to give up on a turn that has said NOTHING at all (e.g. 30m). Default: 3 × COMMAND_TIMEOUT.
# This is the real kill switch, and it only matters for a genuinely wedged engine — a process that
# exits is detected immediately, without waiting this out. Raise it if provider rate-limit backoff
# routinely runs longer than the default.
# CG_MAX_SILENCE=30m
# Transient provider failures (a 5xx / 529 "overloaded", a connection reset, the 2026-09-03 Codex
# "404 Not Found: Unknown error") are retried IN PLACE on the same engine before the turn fails —
# only while no tool ran, never for authentication / usage-limit / model rejections. How many more
# attempts (0–5, 0 disables) and how long between them (ms, or 10s / 1m). Defaults: 2, 10s.
# CG_TRANSIENT_RETRY_ATTEMPTS=2
# CG_TRANSIENT_RETRY_DELAY_MS=10s

# Local voice transcription defaults to 5 minutes per clip. The executable/model paths are
# provisioned by setup; advanced deployments may override them (and ffmpeg) explicitly.
# WHISPER_TIMEOUT_MS=300000
# WHISPER_CLI_PATH=/absolute/path/to/whisper-cli
# WHISPER_MODEL_PATH=/absolute/path/to/ggml-large-v3-turbo.bin
# WHISPER_FFMPEG_PATH=/absolute/path/to/ffmpeg
# Warm-session keep-alive: how long a thread's Claude process stays alive idle so follow-ups
# reply fast without restarting (e.g. 10m). Set 0 to disable warm sessions. Default 10m.
SESSION_KEEPALIVE=10m
# Global cap on concurrent engine runs (excess turns queue). Default 8.
# MAX_CONCURRENT_RUNS=8
# How many of those slots stay reachable only by LIVE turns (Slack/API foreground). Background
# work — schedules, background agents, continuations — can hold a slot for hours, so without a
# reserve a deep enough backlog makes every user wait behind it. Default 2.
# RESERVED_INTERACTIVE_RUNS=2
# Max warm sessions kept alive at once (least-recently-used idle ones are evicted). Default 8.
# WARM_POOL_MAX=8

# ── Claude ────────────────────────────────────────────────────────────────────
# Claude runs inside the channel container using organization API credentials.
# Host subscription logins and setup-token relaying are not used by the daemon.
# ANTHROPIC_API_KEY=

# ── Composio ──────────────────────────────────────────────────────────────────
# Composio MCP endpoint (constant). Per-user tokens are set in the admin UI, not here.
COMPOSIO_MCP_URL=https://connect.composio.dev/mcp

# ── ChannelGate license ───────────────────────────────────────────────────────
# Without a key this install serves ONE conversation per UTC month (500 AI messages in it). A free
# key unlocks every conversation; an Enterprise License removes the message limit. Full details:
# docs/LICENSE-KEYS.md. Normally set in the admin UI (Settings -> License) — this variable is the
# bootstrap source for a container that has never had an admin session.
# CHANNELGATE_LICENSE_KEY=
# Platform base URL. Leave unset for the default (https://channelgate.dev);
# override only for a staging platform.
# CHANNELGATE_PLATFORM_URL=
# Air-gapped deployments: the signed license payload issued by the Licensor, verified locally.
# An install running on this makes NO outbound request — no verification, no usage report.
# CHANNELGATE_LICENSE_PAYLOAD=
# Staging only: overrides the verification public key compiled into src/ee/license-public-key.js.
# CHANNELGATE_LICENSE_PUBLIC_KEY=
