# The ChannelGate channel image: one long-lived container per conversation, engine processes
# exec'd into it. Built by `npm run build:image` (scripts/build-image.mjs), which passes the
# daemon user's real uid/gid and the pins from containers/versions.json.
#
# Two rules shape this file:
#   1. Everything the ENGINE needs is baked in and root-owned, so a channel cannot modify its own
#      toolchain. Everything the channel ACCUMULATES (logins, npm prefix, pip/pipx installs, engine
#      state, caches) lives under /home/agent, which is a per-channel named volume — so it survives
#      a stop, a restart and a recreate. /tmp and /var/tmp are bind mounts of the channel's artifact
#      dir for the same reason (src/runtimes/container/lifecycle.js); nothing here is a tmpfs the
#      idle reaper could empty.
#   2. /home/agent's subdirectories are created HERE, owned by agent. A brand-new named volume is
#      seeded from the image, and the Codex auth file is bind-mounted at
#      /home/agent/.codex/auth.json — if that directory did not already exist in the volume, the
#      container runtime would create it root-owned and Codex could not write its sessions.
FROM node:22-bookworm-slim

ARG UID=1000
ARG GID=1000
ARG CLAUDE_VERSION
ARG CODEX_VERSION
ARG MCP_REMOTE_VERSION
ARG VERCEL_VERSION
ARG SUPABASE_VERSION
ARG PLAYWRIGHT_VERSION
ARG AGENT_BROWSER_VERSION
ARG OPENCV_VERSION
ARG FASTER_WHISPER_VERSION
ARG WHISPER_MODEL=small
ARG IMAGE_SPEC_VERSION=0.0.0
ARG IMAGE_BUILD_DIGEST
ARG IMAGE_TOOLCHAIN

LABEL cg.image.digest="${IMAGE_BUILD_DIGEST}"
LABEL cg.image.toolchain="${IMAGE_TOOLCHAIN}"
LABEL channelgate="1"
LABEL cg.image.version="${IMAGE_SPEC_VERSION}"

ENV DEBIAN_FRONTEND=noninteractive

# Base tooling. Deliberately short: git/gh for the dev channels, ripgrep+jq for the agents' own
# search paths, procps because the container-side helpers and the engines both use it, tini as
# PID 1, postgresql-client for the Supabase workflows, and python3 WITH pip/venv/pipx — after npm,
# python packaging is the most common "install a CLI" path, and everything it installs lands in
# ~/.local, which is inside the per-channel HOME volume and therefore permanent.
# openssh-server is NOT a listening service: cg-sshd runs `sshd -i` on stdio, unprivileged, for one
# gateway-brokered SSH attach session at a time (docs/SSH-ACCESS.md). The container never listens.
# Its post-install generates /etc/ssh/ssh_host_*_key. Nothing uses them — cg-sshd makes each
# channel its own host key and the generated sshd_config pins HostKey to it — but a built image
# would carry those private keys, identical across every channel on the host and public in a
# release archive. They are deleted in THIS step: removed in a later RUN they would still ship in
# this layer.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl ffmpeg git jq less openssh-client openssh-server pipx postgresql-client procps python3 python3-pip python3-venv ripgrep tini unzip \
 && rm -f /etc/ssh/ssh_host_*_key /etc/ssh/ssh_host_*_key.pub \
 && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
 && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends gh \
 && rm -rf /var/lib/apt/lists/*

# The agent user, at the DAEMON's uid/gid so bind-mounted files stay owned by the daemon user on
# both sides (rootless podman's --userns=keep-id maps them 1:1; docker gets --user <uid>:<gid>).
# The base image already ships a `node` user at 1000, so an id collision is renamed out of the way
# rather than left to fail the build.
RUN set -eux; \
    if getent group "${GID}" >/dev/null; then groupmod -n agent "$(getent group "${GID}" | cut -d: -f1)"; \
    else groupadd -g "${GID}" agent; fi; \
    if getent passwd "${UID}" >/dev/null; then \
      old="$(getent passwd "${UID}" | cut -d: -f1)"; \
      usermod -l agent -g "${GID}" -d /home/agent -m -s /bin/bash "$old"; \
    else useradd -u "${UID}" -g "${GID}" -m -d /home/agent -s /bin/bash agent; fi; \
    # "!" (useradd's default) makes sshd refuse the account as locked; "*" is Debian's key-only marker.
    usermod -p '*' agent; \
    install -d -o agent -g agent -m 0755 /home/agent; \
    install -d -o agent -g agent -m 0700 /home/agent/.claude /home/agent/.codex /home/agent/.npm-global /home/agent/.cache /home/agent/.config /home/agent/.local/bin /home/agent/bin

# The pinned engine + provider CLIs, installed into the ROOT-owned global prefix so a channel
# cannot silently downgrade or replace them (the per-channel prefix below is for what the agent
# installs itself, and takes precedence on PATH).
RUN npm install -g --no-fund --no-audit \
      "@anthropic-ai/claude-code@${CLAUDE_VERSION}" \
      "@openai/codex@${CODEX_VERSION}" \
      "mcp-remote@${MCP_REMOTE_VERSION}" \
      "vercel@${VERCEL_VERSION}" \
      "supabase@${SUPABASE_VERSION}" \
 && npm cache clean --force

# Browser automation, for testing a web app and for reading a page a channel is working on.
# Before this, a channel could not open a page at all, and the reason was not obvious: a browser
# downloaded into the channel's own HOME volume STARTED and then died with
# `error while loading shared libraries: libnspr4.so` — the image carried none of Chrome's shared
# libraries, and there is no root inside a container to apt-get them (verified 2026-09-07: eight
# libs missing, apt has no lists, uid is not 0). Both halves are fixed HERE, root-owned like the
# engine CLIs above:
#   * `playwright install --with-deps` is the only maintained source of truth for the exact distro
#     dependency set — never a hand-copied library list, which is what silently rots.
#   * The browsers live under /opt, not /home/agent, so every channel shares ONE copy instead of
#     paying for its own in every per-channel volume. That also makes them root-owned: a channel
#     uses the browser but cannot replace it.
# The chromium revision is a function of the Playwright version, so the build resolves the real
# executable once and puts a STABLE symlink beside it. Everything downstream — the image contract
# in src/runtimes/container/image-paths.js, AGENT_BROWSER_EXECUTABLE_PATH below — points at that
# symlink and never at a revision number.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/channelgate/browsers
RUN npm install -g --no-fund --no-audit \
      "playwright@${PLAYWRIGHT_VERSION}" \
      "agent-browser@${AGENT_BROWSER_VERSION}" \
 && apt-get update \
 && playwright install --with-deps chromium \
 && install -d /opt/channelgate/browsers/bin \
 && ln -sf "$(NODE_PATH="$(npm root -g)" node -e 'console.log(require("playwright").chromium.executablePath())')" \
      /opt/channelgate/browsers/bin/chromium \
 && test -x /opt/channelgate/browsers/bin/chromium \
 && /opt/channelgate/browsers/bin/chromium --version \
 && chmod -R a+rX /opt/channelgate/browsers \
 && npm cache clean --force \
 && rm -rf /var/lib/apt/lists/*

# Organization-wide local video analysis. These packages are root-owned and pinned just like the
# engine CLIs above; channels use them but cannot replace them. Preload the default speech model so
# the first video in a network-restricted channel does not wait for or depend on a download.
ENV HF_HOME=/opt/channelgate/models/huggingface
RUN pip3 install --break-system-packages --no-cache-dir \
      "opencv-python-headless==${OPENCV_VERSION}" \
      "faster-whisper==${FASTER_WHISPER_VERSION}" \
 && python3 -c "from faster_whisper import WhisperModel; WhisperModel('${WHISPER_MODEL}', device='cpu', compute_type='int8')" \
 && chmod -R a+rX /opt/channelgate/models

# VS Code servers, shared by every channel. VS Code's remote extensions install a ~620 MB server
# (plus a 34 MB CLI) per client version into ~/.vscode-server — and /home/agent is the per-channel
# volume, so every channel someone opened an editor in paid for its own copy (measured: 687 MB of
# the 689 MB in one channel's .vscode-server, extensions 8 KB). Baked here, root-owned like the
# browsers above, every channel shares ONE copy per pinned version; cg-init links them into the
# volume on each start, in both layouts VS Code looks for (attach-container: bin/<commit>;
# Remote-SSH: cli/servers/Stable-<commit>/server and code-<commit>). A client on an unlisted version
# is unaffected: it downloads its own server into the volume exactly as before.
# Each entry is commit:serverSha256:cliSha256 from containers/versions.json. The hashes are VS
# Code's own published sha256; a download that does not match fails the build rather than
# shipping a different editor. An empty list builds an image without shared servers.
ARG VSCODE_SERVERS=
RUN set -eu; \
    for entry in $VSCODE_SERVERS; do \
      commit="${entry%%:*}"; rest="${entry#*:}"; server_sha="${rest%%:*}"; cli_sha="${rest#*:}"; \
      dir="/opt/channelgate/vscode-server/$commit"; \
      curl -fsSL --retry 3 -o /tmp/vscode-server.tgz "https://update.code.visualstudio.com/commit:$commit/server-linux-x64/stable"; \
      echo "$server_sha  /tmp/vscode-server.tgz" | sha256sum -c -; \
      curl -fsSL --retry 3 -o /tmp/vscode-cli.tgz "https://update.code.visualstudio.com/commit:$commit/cli-alpine-x64/stable"; \
      echo "$cli_sha  /tmp/vscode-cli.tgz" | sha256sum -c -; \
      install -d "$dir/server" "$dir/cli"; \
      tar xzf /tmp/vscode-server.tgz -C "$dir/server" --strip-components=1 --no-same-owner; \
      tar xzf /tmp/vscode-cli.tgz -C "$dir/cli" --no-same-owner; \
      test "$(node -p "require('$dir/server/product.json').commit")" = "$commit"; \
      test -x "$dir/server/bin/code-server"; \
      test -x "$dir/cli/code"; \
      rm -f /tmp/vscode-server.tgz /tmp/vscode-cli.tgz; \
    done; \
    if [ -d /opt/channelgate/vscode-server ]; then chmod -R a+rX,go-w /opt/channelgate/vscode-server; fi

# The gateway's own in-container bundle: the process helpers plus the minimal set of daemon modules
# an ENGINE spawns during a run (the MCP bridges and the Stop hook), resolved as an import closure
# by the build script — never the whole checkout, which is never mounted either.
COPY --chown=root:root bin/ /opt/channelgate/bin/
COPY --chown=root:root bundle/ /opt/channelgate/
# The bundle's package.json declares only what those modules import; `type: module` in it is what
# makes /opt/channelgate/**/*.js (including bin/cg-mcp-bridge.js) load as ES modules.
RUN chmod 0755 /opt/channelgate/bin/* \
 && cd /opt/channelgate && npm install --omit=dev --no-fund --no-audit && npm cache clean --force \
 && printf '%s\n' "${IMAGE_SPEC_VERSION}" > /opt/channelgate/VERSION

# Every writable location here is under /home/agent — the per-channel named volume — so a CLI the
# agent installs is still installed after a stop, a restart or a recreate. PIP_USER +
# PIP_BREAK_SYSTEM_PACKAGES make a plain `pip install <cli>` land in ~/.local instead of failing on
# Debian's externally-managed-environment marker; pipx puts its venvs and shims there too.
# (Inside a hand-made venv, `pip install` needs PIP_USER=0 — see docs/OPERATIONS.md.)
ENV CG_RUNTIME=container \
    HOME=/home/agent \
    AGENT_BROWSER_EXECUTABLE_PATH=/opt/channelgate/browsers/bin/chromium \
    NPM_CONFIG_PREFIX=/home/agent/.npm-global \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    CLAUDE_CONFIG_DIR=/home/agent/.claude \
    CODEX_HOME=/home/agent/.codex \
    PIP_USER=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIPX_HOME=/home/agent/.local/pipx \
    PIPX_BIN_DIR=/home/agent/.local/bin \
    PATH=/home/agent/.npm-global/bin:/home/agent/.local/bin:/home/agent/bin:/opt/channelgate/bin:/usr/local/bin:/usr/bin:/bin:/home/agent/.cargo/bin:/home/agent/.bun/bin:/home/agent/.deno/bin:/home/agent/go/bin

# Codex runs every shell command through a LOGIN shell (`bash -lc`), and Debian's /etc/profile
# resets PATH to the distro default on the way in — which silently dropped the per-channel npm
# prefix, the gateway helpers and every other entry above. /etc/profile.d runs AFTER that reset, so
# the image PATH is re-asserted there for login shells; non-login shells (Claude's Bash tool, a
# plain `podman exec`) inherit the ENV PATH directly. Bash then sources ~/.profile, whose Debian
# skeleton prepends ~/bin and ~/.local/bin once more — harmless duplicates.
RUN printf 'export PATH="%s"\n' "$PATH" > /etc/profile.d/channelgate-path.sh \
 && chmod 0644 /etc/profile.d/channelgate-path.sh

# An interactive SSH login starts in the channel's work folder instead of HOME (spec 1.5.1). The
# gateway's in-container sshd_config hands every session CG_WORKDIR. Only an INTERACTIVE shell of an
# SSH session that is still in HOME moves: Codex runs each command through `bash -lc` (a login shell,
# but not interactive, and never an SSH session), and a `cd` there would change where it runs.
RUN printf '%s\n' \
      '# ChannelGate: an interactive SSH login starts in the channel work folder (CG_WORKDIR).' \
      'if [ -n "${SSH_CONNECTION:-}" ] && [ -n "${CG_WORKDIR:-}" ] && [ "$PWD" = "$HOME" ] && [ -d "$CG_WORKDIR" ]; then' \
      '  case $- in *i*) cd "$CG_WORKDIR" || true ;; esac' \
      'fi' > /etc/profile.d/channelgate-workdir.sh \
 && chmod 0644 /etc/profile.d/channelgate-workdir.sh

USER agent
WORKDIR /home/agent

# tini reaps the orphans a long-lived agent container inevitably produces; cg-init prepares the
# HOME volume on EVERY start (not just at build time) and then execs the real command.
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/opt/channelgate/bin/cg-init", "sleep", "infinity"]
