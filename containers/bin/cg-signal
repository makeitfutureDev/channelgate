#!/bin/sh
# cg-signal <runId> <SIG> — deliver a signal to EVERYTHING the run started, the container-side
# equivalent of the host backend's negative-pid killTree.
#
# The run's process GROUP (engine + its MCP stdio children + mcp-remote bridges) is not the whole
# run: Claude Code's Bash tool puts its shell in a NEW session AND a new process group, so
# `kill -- -<leader>` reported success while the tool's shell — and the command it was running —
# kept going, and a loop ran to completion minutes after the turn was reported stopped (live,
# CTR-11). Codex keeps its shell in the run's group, which is why only Claude leaked.
#
# So the escapees are found rather than assumed: /proc is walked ONCE, BEFORE anything is signalled
# (the tree is still intact at that instant — an escapee re-parents to pid 1 only once the leader
# dies), and every process that is in the run's SESSION or anywhere in the leader's DESCENDANT tree
# is signalled, by process group (deduped) and then by pid. Nothing outside the run can be in
# either set: the leader is its own session leader (cg-exec's `setsid`), a detached background job
# is a separate leader with a session of its own, and a process group never spans sessions.
#
# Exit status is unchanged: 0 when at least one signal was delivered, 1 when nothing was.
id="$1"
sig="${2:-TERM}"
sig="${sig#SIG}"
[ -n "$id" ] || exit 2
dir="${CG_RUN_DIR:-/run/cg}"
pid=$(cat "$dir/$id.pid" 2>/dev/null) || exit 1
[ -n "$pid" ] || exit 1

# pid:ppid:pgrp:session for every live process. `comm` is unquoted and may hold spaces and
# parentheses, so the fields are read from after the LAST ")" — state, ppid, pgrp, session.
# The redirection is what fails for a process that exits mid-walk, so its error is suppressed
# BEFORE it is opened; `2>/dev/null` after the input redirection would print on stderr.
table=$(
  for entry in /proc/[0-9]*; do
    p=${entry#/proc/}
    read -r line 2>/dev/null < "$entry/stat" || continue
    rest=${line##*") "}
    set -- $rest
    [ $# -ge 4 ] || continue
    printf '%s:%s:%s:%s\n' "$p" "$2" "$3" "$4"
  done
)

# The run's session, then the leader's descendants — repeated passes until a pass adds nothing,
# which is the tree's depth (the cap only bounds a /proc that changes under us).
marked=" $pid "
for row in $table; do
  [ "${row##*:}" = "$pid" ] || continue
  p=${row%%:*}
  case "$marked" in *" $p "*) ;; *) marked="$marked$p " ;; esac
done
depth=0
while [ "$depth" -lt 64 ]; do
  depth=$((depth + 1))
  added=0
  for row in $table; do
    p=${row%%:*}
    case "$marked" in *" $p "*) continue ;; esac
    parent=${row#*:}; parent=${parent%%:*}
    case "$marked" in *" $parent "*) marked="$marked$p "; added=1 ;; esac
  done
  [ "$added" = 1 ] || break
done

groups=""
for row in $table; do
  p=${row%%:*}
  case "$marked" in *" $p "*) ;; *) continue ;; esac
  g=${row#*:}; g=${g#*:}; g=${g%%:*}
  case "$g" in ''|*[!0-9]*) continue ;; esac
  # Never -1 ("every process the caller may signal") and never init's group.
  [ "$g" -gt 1 ] || continue
  case " $groups " in *" $g "*) ;; *) groups="$groups $g" ;; esac
done

delivered=0
kill -s "$sig" -- "-$pid" 2>/dev/null && delivered=1
for g in $groups; do
  [ "$g" = "$pid" ] && continue
  kill -s "$sig" -- "-$g" 2>/dev/null && delivered=1
done
for p in $marked; do
  [ "$p" = "$$" ] && continue
  [ "$p" -gt 1 ] || continue
  kill -s "$sig" "$p" 2>/dev/null && delivered=1
done
[ "$delivered" = 1 ] && exit 0

# /proc unreadable (or the group form refused): the leader alone, as before.
kill -s "$sig" "-$pid" 2>/dev/null && exit 0
kill -s "$sig" "$pid" 2>/dev/null && exit 0
exit 1
