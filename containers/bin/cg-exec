#!/bin/sh
# cg-exec <runId> <cmd> [args…] — run one gateway command as the leader of its OWN session and
# process group, and record that leader's pid so a LATER, SEPARATE exec (cg-probe / cg-signal) can
# address the whole tree. The daemon's host-side client is a `<cli> exec` process in another pid
# namespace: its pid names the client, never the engine, so liveness and signals have to be asked
# for from inside. `setsid -w` keeps the run in the foreground of the exec session, so the client's
# exit code and stdio stay the engine's — the runners see no difference from a host spawn.
#
# The exit status is also RECORDED (<runId>.rc), because a detached run (`exec -d`) has no client
# to report it: cg-probe hands it back once the run is over.
set -u
id="$1"
[ -n "$id" ] || { echo "cg-exec: missing run id" >&2; exit 64; }
shift
[ $# -gt 0 ] || { echo "cg-exec: missing command" >&2; exit 64; }
# Where the pidfiles live. Always /run/cg inside the image; overridable so the helpers can be
# exercised for real (cg-exec + cg-signal against the kernel's own /proc) from a test.
dir="${CG_RUN_DIR:-/run/cg}"
mkdir -p "$dir" 2>/dev/null || true
rm -f "$dir/$id.rc" 2>/dev/null || true
# $0 inside `sh -c` is the run id and $1 the pidfile directory; what is left after the shift is the
# command. $$ is that shell — setsid made it the SESSION and group leader, and `exec` keeps its
# pid, so the recorded pid IS both the group leader (-pid works) and the session id.
setsid -w /bin/sh -c 'd="$1"; shift; echo $$ > "$d/$0.pid"; exec "$@"' "$id" "$dir" "$@"
rc=$?
printf '%s\n' "$rc" > "$dir/$id.rc" 2>/dev/null || true
exit "$rc"
