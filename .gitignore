node_modules/
.env
# Backups/variants of .env carry the same secrets (a .env.bak.<ts> appeared on 2026-08-26) — never track them.
.env.*
!.env.example
*.log

# Generated release evidence and private deployment instructions.
/dist/
/AGENTS.local.md

# Runtime gateway root, if a developer points it inside the repo for testing.
.channelgate/

# Project MCP config carries plaintext credentials (e.g. aioutreach headers) — never commit it.
.mcp.json

# Runtime leakage when the daemon/a channel folder is pointed at the repo root during testing:
# per-channel agent memory + downloaded attachments. Not source. (Anchored to root only.)
/MEMORY.md
/memory/
/uploads/

# Config backups live OUTSIDE the repo (~/.channelgate/backups) — even encrypted credential
# blobs must never enter git history. Ignore any local straggler entirely.
*.backup-key
.backup-key
backup/
.gh/

# Runtime skill mirrors and Claude worktree state. Bundled source packages live in
# src/gateway/skills/bundled/ so selecting this checkout cannot delete tracked sources.
.claude/skills/*
.claude/worktrees/
.agents/skills
